{
  "name": "dsh-remote-web",
  "version": "0.1.0",
  "description": "DSH plugin: secure remote web access to a local DeepSeek Harness through a self-hosted relay, with token authentication and outbound-only tunneling.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alan-IFT/dsh_remote_web.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./lib/index.js",
  "bin": {
    "dsh-remote-web": "./lib/cli.js"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./relay": {
      "default": "./lib/relay.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "deploy/**/*",
    "README.md",
    "README.en.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.5 || 0.1.0-rc.6 || 0.1.0-rc.7 || 0.1.0-rc.8"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsdown": "^0.9.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "bugs": {
    "url": "https://github.com/Alan-IFT/dsh_remote_web/issues"
  },
  "homepage": "https://github.com/Alan-IFT/dsh_remote_web#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "remote",
    "tunnel",
    "end-to-end-encryption",
    "relay",
    "plugin"
  ]
}
