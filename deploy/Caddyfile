# TLS terminator in front of the relay.
#
# Caddy obtains and renews certificates automatically, so the relay itself
# never handles keys. The relay is started with --trust-proxy, which is only
# correct because this file is the single ingress: X-Forwarded-For can be
# trusted precisely because nothing else can reach the relay.

{$RELAY_DOMAIN} {
	encode zstd gzip

	# WebSocket upgrades and streaming responses must not be buffered:
	# the DSH downlink pushes events continuously.
	reverse_proxy relay:8787 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# Remote access to a machine that runs code must never be framed.
		X-Frame-Options "DENY"
		-Server
	}

	log {
		# Access logs record paths; tokens never appear in a URL by design,
		# because login is a POST body.
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
