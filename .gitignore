# Dependencies
node_modules/
.pnpm-store/

# lib/ is deliberately committed. This plugin is installed straight from git,
# and pnpm blocks a git dependency's build script until the user allowlists it
# by exact commit hash — a line they would have to rewrite on every update.
# Shipping the built output removes that step entirely; `pnpm build` before a
# release keeps it in step with src/.

# Runtime state — these hold live credentials and must never be committed
relay-state.json
agent.json
status.json
*.tmp

# Local noise
*.log
.DS_Store
